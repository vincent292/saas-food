# Yopido SaaS - Next.js
# Copia este archivo como .env.local o .env.

# URL publica del SaaS. Se usa para SEO, links, callbacks y panel.
NEXT_PUBLIC_SITE_URL=https://www.yopido.shop
SITE_URL=https://www.yopido.shop
NEXT_PUBLIC_APP_URL=https://www.yopido.shop

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alias compatible con proyectos Supabase antiguos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# WhatsApp Cloud API / Meta
# Número central existente: Next.js + Supabase Edge Functions.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Solo Edge Function: verificación inicial del webhook.
VERIFY_TOKEN=
# Obligatorio con conexiones por sucursal: MISMO secret en Next.js y Edge Functions.
META_APP_SECRET=
# Embedded Signup / coexistencia: solo servidor Next.js (sin NEXT_PUBLIC_).
META_APP_ID=
META_WHATSAPP_CONFIG_ID=
# Next.js y Edge Functions deben usar la misma versión.
META_GRAPH_API_VERSION=v26.0
# Clave base64 de 32 bytes para cifrar tokens. MISMA clave en Next.js y Edge Functions.
# Generar UNA VEZ en un entorno seguro: openssl rand -base64 32
# No rotar sin recifrar las conexiones; no guardar en Git ni compartir en el chat.
WHATSAPP_CREDENTIALS_KEY=
# Alias opcional para compatibilidad local; en Supabase usa VERIFY_TOKEN.
WHATSAPP_VERIFY_TOKEN=

# Google Auth / Workspace
# Google login se configura en Supabase Dashboard > Authentication > Providers > Google.
# En Google Cloud usa OAuth Client Web y agrega callbacks de Supabase:
# https://<tu-proyecto>.supabase.co/auth/v1/callback
# Redirect URLs que deben estar permitidas en Supabase:
# https://www.yopido.shop/auth/callback
# ridersmobile://auth/callback
# Para Expo Go tambien agrega la URL que muestre Expo:
# exp://<ip-o-tunnel>:8081/--/auth/callback

# Google Maps / Places
# Habilita Maps JavaScript API, Places API y Geocoding API para el panel web.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Alias opcional leido por algunos componentes.
NEXT_PUBLIC_GOOGLE_API_KEY=
# Opcional si usas Map ID en Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# IA / soporte
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SUPPORT_AI_MODEL=gemini-3.6-flash

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=yopido-public
R2_PRIVATE_BUCKET=yopido-private
R2_PUBLIC_URL=https://assets.tu-dominio.com

# Optional overrides
R2_ENDPOINT=
R2_REGION=auto
